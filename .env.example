# ── Network ─────────────────────────────────────────
NEXT_PUBLIC_SNIPLY_NETWORK=testnet           # testnet | mainnet
NEXT_PUBLIC_BSC_TESTNET_RPC=                 # optional custom RPC (defaults to public)
NEXT_PUBLIC_BSC_RPC=
BSC_TESTNET_RPC_URL=                         # server-side RPC (recommended: dedicated provider)
BSC_RPC_URL=                                 # used for Agent ID verification on BSC mainnet

# ── Wallets ─────────────────────────────────────────
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=        # enables WalletConnect / mobile wallets

# ── Binance Agent ID ────────────────────────────────
# Defaults to the registry used by Agent ID Hackathon projects; NOT confirmed by official docs.
NEXT_PUBLIC_AGENT_ID_REGISTRY=0x60B9262456dE011F7d15a54CdD8c48bAaa8B022F

# ── Token launch (disabled unless both are set) ─────
NEXT_PUBLIC_LAUNCHPAD=none                   # none | sniply-factory
NEXT_PUBLIC_SNIPLY_FACTORY_ADDRESS=          # deployed + reviewed SniplyTokenFactory (testnet first)

# ── Company treasury (public address only) ───────
# Official Sniply company wallet on BNB Smart Chain mainnet (chain 56). Read-only in the app:
# Sniply never stores or asks for its private key and never moves funds to or from it.
SNIPLY_TREASURY_ADDRESS=0xfEB14057bbF5Ba1C18a28E13a0Bf6e4c7DC337Ff
ALLOW_TREASURY_SIGNIN=false                  # keep the treasury out of user sign-in

# ── Auth / admin ────────────────────────────────────
SESSION_SECRET=                              # >= 32 random chars (required in production)
ADMIN_WALLETS=                               # comma-separated lowercase addresses

# ── Database & storage (local JSON + .data/uploads used when unset) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=                   # server only, never expose
SUPABASE_STORAGE_BUCKET=sniply-media
MAX_UPLOAD_MB=500

# ── AI providers ────────────────────────────────────
ANTHROPIC_API_KEY=                           # titles, captions, token metadata suggestions
AI_TEXT_MODEL=claude-haiku-5-5
TRANSCRIPTION_API_KEY=                       # speech-to-text provider for production worker
